@page "/user/edit/{id:int}"
@using ApiContracts
@using BlazorApp.Services
@inject IUserService UserService
@inject NavigationManager Navigation

<h3>Edit User</h3>

@if (errorMessage != null)
{
    <div class="alert alert-danger">@errorMessage</div>
}

@if (user == null)
{
    <p><em>Loading user data...</em></p>
}
else
{
    <EditForm Model="user" OnValidSubmit="HandleUpdate" FormName="EditUserForm">
        <div class="mb-3">
            <label class="form-label">User ID:</label>
            <input class="form-control" value="@user.Id" disabled />
        </div>
        
        <div class="mb-3">
            <label class="form-label">Username / Display Name:</label>
            <InputText class="form-control" @bind-Value="user.UserName" />
        </div>

        <button type="submit" class="btn btn-primary">Save Changes</button>
        <a href="/user" class="btn btn-secondary ms-2">Cancel</a>
    </EditForm>
}

@code {
    [Parameter]
    public int id { get; set; }

    private UserDto? user;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            user = await UserService.GetUserAsync(id);
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading user: {ex.Message}";
        }
    }

    private async Task HandleUpdate()
    {
        errorMessage = null;
        try
        {
            await UserService.UpdateUserAsync(id, user!);
            Navigation.NavigateTo("/user");
        }
        catch (Exception ex)
        {
            errorMessage = $"Error updating user: {ex.Message}";
        }
    }
}