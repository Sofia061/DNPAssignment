@page "/comment/edit/{id:int}"
@using ApiContracts
@using BlazorApp.Services
@inject ICommentService CommentService
@inject NavigationManager Navigation

<h3>Edit Comment</h3>

@if (errorMessage != null)
{
    <div class="alert alert-danger">@errorMessage</div>
}

@if (comment == null)
{
    <p><em>Loading comment...</em></p>
}
else
{
    <EditForm Model="comment" OnValidSubmit="HandleUpdate" FormName="EditCommentForm">
        <div class="mb-3">
            <label class="form-label">Body:</label>
            <InputTextArea class="form-control" @bind-Value="comment.Body" />
        </div>
        <button type="submit" class="btn btn-primary">Save Changes</button>
        <a href="/comment" class="btn btn-secondary ms-2">Cancel</a>
    </EditForm>
}

@code {
    [Parameter]
    public int id { get; set; }

    private CommentDto? comment;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            comment = await CommentService.GetCommentAsync(id);
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading comment: {ex.Message}";
        }
    }

    private async Task HandleUpdate()
    {
        errorMessage = null;
        try
        {
            await CommentService.UpdateCommentAsync(id, comment!);
            Navigation.NavigateTo("/comment");
        }
        catch (Exception ex)
        {
            errorMessage = $"Error updating comment: {ex.Message}";
        }
    }
}